# ---------------------------------------------------------------------------
# PDFly - example environment. Copy to `.env` (root is read by the server) and
# `client/.env` for Vite variables. All values are optional; defaults shown.
# ---------------------------------------------------------------------------

# ----- Server (server/.env or root .env) -----
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# Comma separated list of allowed browser origins (use * to allow all)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Temporary directory for uploads/outputs (auto-cleaned). Defaults to <os tmp>/pdfly
# TMP_DIR=/var/tmp/pdfly
MAX_FILE_SIZE_MB=50
MAX_FILES_PER_REQUEST=50
# How long processed files stay downloadable (minutes)
FILE_TTL_MINUTES=60
CLEANUP_INTERVAL_MINUTES=5
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
# Kill external processes (LibreOffice, Ghostscript...) after this many ms
PROCESS_TIMEOUT_MS=300000
# Allow HTML-to-PDF from public URLs (disable in locked-down deployments)
ALLOW_URL_FETCH=true
# Where tesseract.js caches language data
# TESSDATA_DIR=/var/tmp/pdfly-tessdata
# Serve the built client from the server (single-process deployment)
SERVE_CLIENT=false
# CLIENT_DIST=../client/dist

# Optional explicit paths to external tools (auto-detected on PATH otherwise)
# SOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
# GHOSTSCRIPT_PATH=gswin64c
# QPDF_PATH=qpdf
# TESSERACT_PATH=tesseract
# PDFTOPPM_PATH=pdftoppm
# OCRMYPDF_PATH=ocrmypdf

# ----- Client (client/.env) - must be prefixed with VITE_ -----
# API base URL. In development Vite proxies /api to the server (VITE_PROXY_TARGET).
VITE_API_BASE_URL=/api
VITE_PROXY_TARGET=http://localhost:4000
VITE_MAX_FILE_SIZE_MB=50
