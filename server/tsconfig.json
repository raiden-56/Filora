{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@pdfly/core": ["../packages/pdf-core/src/index.ts"]
    }
  },
  "include": ["src", "../packages/pdf-core/src"]
}
